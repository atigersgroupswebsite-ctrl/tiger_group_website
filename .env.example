# Client-Side Supabase Configuration (Public / Browser Safe)
# These are exposed to the browser and only have permissions granted to the 'anon' role via RLS.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Server-Side / Backend Supabase Configuration (PRIVATE - NEVER EXPOSE TO CLIENT)
# Used exclusively in secure server environments / edge functions. NEVER prefix with VITE_.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
