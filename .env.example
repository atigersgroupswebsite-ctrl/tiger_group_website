# Client-Side Supabase Configuration (Public / Browser Safe)
# These are exposed to the browser and only have permissions granted to the 'anon' role via RLS.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Canonical Site URL (Used for Supabase Auth Magic Link redirects)
# Development: http://localhost:5173
# Production (e.g. Vercel): https://your-production-domain.vercel.app
VITE_SITE_URL="http://localhost:5173"

# Server-Side / Backend Supabase Configuration (PRIVATE - NEVER EXPOSE TO CLIENT)
# Used exclusively in secure server environments / edge functions. NEVER prefix with VITE_.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# Cashfree Payment Gateway Configuration (Server-Only, NEVER prefix with VITE_)
# CASHFREE_ENVIRONMENT options: SANDBOX or PRODUCTION (default: SANDBOX)
CASHFREE_ENVIRONMENT="SANDBOX"
CASHFREE_APP_ID="your-cashfree-app-id"
CASHFREE_SECRET_KEY="your-cashfree-secret-key"

# Optional Client Environment Mode Override (Default: resolves dynamically from server payment config)
# VITE_CASHFREE_ENVIRONMENT="PRODUCTION"

