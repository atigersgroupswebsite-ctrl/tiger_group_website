{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/payment/(.*)",
      "destination": "/api/payment?_action=$1"
    },
    {
      "source": "/api/payments/(.*)",
      "destination": "/api/payment?_action=$1"
    },
    {
      "source": "/api/enquiries/(.*)",
      "destination": "/api/enquiries?_action=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|favicon\\..*|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}

